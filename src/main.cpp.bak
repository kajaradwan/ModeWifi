void setup() {
    // Initialize Serial communication
    Serial.begin(115200);
    delay(1000);  // Give serial time to initialize
    Serial.println("\n\n=== ModeWifi Starting ===");
    Serial.println("Initializing SPI...");

    // Initialize SPI for CAN bus
    SPI.begin();
    Serial.println("SPI initialized");
    
    // Initialize CAN bus
    Serial.println("Initializing CAN bus...");
    mcp2515.reset();
    mcp2515.setBitrate(CAN_500KBPS, MCP_8MHZ);
    mcp2515.setNormalMode();
    Serial.println("CAN bus initialized");
    
    // Initialize BLE
    Serial.println("Starting BLE initialization...");
    BLEDevice::init(DEVICE_NAME);
    Serial.println("BLE initialized");

    // Create the BLE Server
    Serial.println("Creating server...");
    pServer = BLEDevice::createServer();
    pServer->setCallbacks(new TestServerCallbacks());
    Serial.println("Server created");

    // Create the BLE Service
    Serial.println("Creating service...");
    BLEService *pService = pServer->createService(SERVICE_UUID);
    Serial.println("Service created");

    // Create a BLE Characteristic
    Serial.println("Creating characteristic...");
    pCharacteristic = pService->createCharacteristic(
        CHARACTERISTIC_UUID,
        BLECharacteristic::PROPERTY_READ |
        BLECharacteristic::PROPERTY_WRITE |
        BLECharacteristic::PROPERTY_NOTIFY
    );
    pCharacteristic->addDescriptor(new BLE2902());
    Serial.println("Characteristic created");

    // Start the service
    Serial.println("Starting service...");
    pService->start();
    Serial.println("Service started");

    // Start advertising
    Serial.println("Starting advertising...");
    BLEAdvertising *pAdvertising = pServer->getAdvertising();
    pAdvertising->addServiceUUID(SERVICE_UUID);
    pAdvertising->setScanResponse(true);
    pAdvertising->setMinPreferred(0x06);  // functions that help with iPhone connections issue
    pAdvertising->setMinPreferred(0x12);
    pAdvertising->start();
    Serial.println("Advertising started");
    Serial.println("=== Setup Complete ===");
    Serial.println("BLE device should be discoverable as 'ModeWifi'");
}

void loop() {
    static unsigned long lastDebug = 0;
    unsigned long now = millis();
    
    // Update BLE interface
    bleInterface.update();
    
    // Handle CAN messages
    if (mcp2515.readMessage(&canMsg) == MCP2515::ERROR_OK) {
        handlePDMMessage(millis() / 1000.0, canMsg);
    }
    
    // Print debug message every 5 seconds
    if (now - lastDebug > 5000) {
        Serial.println("System running... BLE should be advertising");
        lastDebug = now;
    }
    
    if (deviceConnected) {
        // Send a notification every second
        static unsigned long lastNotification = 0;
        if (millis() - lastNotification > 1000) {
            String message = "Hello from ModeWifi! " + String(millis());
            pCharacteristic->setValue(message.c_str());
            pCharacteristic->notify();
            lastNotification = millis();
        }
    }
    
    // Small delay to prevent CPU hogging
    delay(10);
}
